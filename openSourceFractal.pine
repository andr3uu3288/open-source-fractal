//@version=6
indicator("openSourceFractal", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

//#region [INPUTS]

grpModel   = 'General Settings'
showAlerts = input.bool(true, 'Alerts?', group = grpModel, inline = 'alerts', tooltip = "To turn on the alerts, follow these steps:\n\n1) Make sure that the 'Alerts?' toggle is ON.\n2) Find, and click on, the three dots next to the indicator title on the top left of your chart, or right-click on the indicator on the chart.\n3) Click 'Add Alert on Fractal Model [Pro+]'\n4) Choose the Alert Name, if you wish, and confirm by clicking 'Create'")
showEarlyCisdAlerts = input.bool(false, 'Early CISD Alerts?', group = grpModel, inline = 'alerts', tooltip = "The global 'Alerts?' toggle above acts as a master switch. If it is OFF, Early CISD alerts will not fire even if this toggle is ON.")
showHistory = input.int(1, 'History', minval = 0, maxval = 40, group = grpModel, tooltip = 'Number of past setups (valid or invalidated) to keep drawn on the chart. 0 = unlimited.')
biasFilter = input.string('Neutral', 'Bias', options = ['Neutral', 'Bullish', 'Bearish', 'Auto Bias 1', 'Auto Bias 2', 'Auto Bias Confluence'], group = grpModel, tooltip = 'Auto Bias 1 filters with the active confirmed Fractal Model one alignment higher. Auto Bias 2 references two alignments higher. Auto Bias Confluence requires both higher Fractal Models to be active and aligned in the same direction. Auto modes remain neutral when the required higher model is not active.')
poiFilter  = input.string('Off', 'POI Filter', options = ['Off', 'Any POI', 'FVG', 'Swing', 'Opposing Candle'], group = grpModel, inline = 'poi', tooltip = 'Optional higher-timeframe context filter. Any POI uses course priority: FVG first, then a confirmed swing high/low, then an opposing-candle body. Off preserves the original setup behavior.')
poiLookback = input.int(20, 'Lookback', minval = 5, maxval = 50, group = grpModel, inline = 'poi', tooltip = 'Completed higher-timeframe candles searched for a POI that existed before the qualifying C2 sweep began.')
modelType  = input.string('Auto', 'Fractal', options = ['Custom', 'Auto', '1m-15m', '3m-30m', '5m-1H', '15m-4H', '1H-1D', '4H-1W', '1D-1W'], group = grpModel, inline = 'fractal')
showEarlyCisd = input.bool(true, 'Early CISD', group = grpModel, inline = 'fractal')
customLTF  = input.timeframe('5',  'Custom LTF                      ', group = grpModel, inline = 'custom', active = modelType == 'Custom')
customHTF  = input.timeframe('60', '', group = grpModel, inline = 'custom', tooltip = 'Only active when Alignment is set to Custom', active = modelType == 'Custom')

grpCandles     = 'HTF Candles'
htfCandleCount = input.int(4, 'HTF Candles', minval = 1, maxval = 10, group = grpCandles, inline = 'count')
hideHtf        = input.bool(false, 'Hide?', group = grpCandles, inline = 'count', tooltip = 'Hide HTF candles preview')
candleOffsetIn = input.int(0, 'Offset', minval = 0, group = grpCandles)

bullBody   = input.color(color.new(color.green, 0), 'Body', group = grpCandles, inline = 'body')
bearBody   = input.color(color.new(#000000, 0), '', group = grpCandles, inline = 'body')
borderBull = input.color(color.new(#000000, 0), 'Borders', group = grpCandles, inline = 'border')
borderBear = input.color(color.new(#000000, 0), '', group = grpCandles, inline = 'border')
wickBull   = input.color(color.new(#000000, 0), 'Wick', group = grpCandles, inline = 'wick')
wickBear   = input.color(color.new(#000000, 0), '', group = grpCandles, inline = 'wick')

showHtfOpen  = input.bool(true, 'HTF Open', group = grpCandles, inline = 'htfopen')
htfOpenColor = input.color(color.new(#1a1a1a, 30), '', group = grpCandles, inline = 'htfopen')
htfOpenStyle = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpCandles, inline = 'htfopen')
htfOpenWidth = input.int(1, '', minval = 1, group = grpCandles, inline = 'htfopen')

showVlines = input.bool(true, 'O/C Time', group = grpCandles, inline = 'vline')
lineColor  = input.color(color.new(color.gray, 60), '', group = grpCandles, inline = 'vline')
lineStyle  = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpCandles, inline = 'vline')
lineWidth  = input.int(1, '', minval = 1, group = grpCandles, inline = 'vline')

showLH  = input.bool(false, 'L/H Lines', group = grpCandles, inline = 'lh')
lhColor = input.color(color.new(#1a1a1a, 30), '', group = grpCandles, inline = 'lh')
lhStyle = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpCandles, inline = 'lh')
lhWidth = input.int(1, '', minval = 1, group = grpCandles, inline = 'lh')

grpVisuals = 'Model Style'
showLabels = input.bool(true, 'Labels?', group = grpVisuals, inline = 'lbl')
labelSize  = input.string('Small', '', group = grpVisuals, inline = 'lbl', options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge'], active = showLabels)
showSweep  = input.bool(false, 'Candle 1 Sweep', group = grpVisuals, inline = 'sweep')
sweepColor = input.color(color.new(#000000, 0), '', group = grpVisuals, inline = 'sweep')
sweepStyle = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpVisuals, inline = 'sweep')
sweepWidth = input.int(1, '', minval = 1, group = grpVisuals, inline = 'sweep')

earlyCisdColor = input.color(color.new(color.blue, 0), 'Early CISD', group = grpVisuals, inline = 'earlycisd', active = showEarlyCisd)
earlyCisdStyle = input.string('Dashed', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpVisuals, inline = 'earlycisd', active = showEarlyCisd)
earlyCisdWidth = input.int(1, '', minval = 1, group = grpVisuals, inline = 'earlycisd', active = showEarlyCisd)

showBullCisd  = input.bool(true, 'Bullish CISD', group = grpVisuals, inline = 'bullcisd')
cisdBullColor = input.color(color.new(color.blue, 0), '', group = grpVisuals, inline = 'bullcisd')
cisdBullStyle = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpVisuals, inline = 'bullcisd', active = showBullCisd)
cisdBullWidth = input.int(1, '', minval = 1, group = grpVisuals, inline = 'bullcisd', active = showBullCisd)

showBearCisd  = input.bool(true, 'Bearish CISD', group = grpVisuals, inline = 'bearcisd')
cisdBearColor = input.color(color.new(color.blue, 0), '', group = grpVisuals, inline = 'bearcisd')
cisdBearStyle = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpVisuals, inline = 'bearcisd', active = showBearCisd)
cisdBearWidth = input.int(1, '', minval = 1, group = grpVisuals, inline = 'bearcisd', active = showBearCisd)

showEQ  = input.bool(true, 'Candle Equilibrium', group = grpVisuals, inline = 'eq')
eqColor = input.color(color.new(#000000, 0), '', group = grpVisuals, inline = 'eq')
eqStyle = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpVisuals, inline = 'eq')
eqWidth = input.int(1, '', minval = 1, group = grpVisuals, inline = 'eq')

showTSpot      = input.bool(true, 'T-Spot Box', group = grpVisuals, inline = 'tspot')
tSpotBullColor = input.color(color.new(color.green, 80), '', group = grpVisuals, inline = 'tspot')
tSpotBearColor = input.color(color.new(color.gray, 80), '', group = grpVisuals, inline = 'tspot')

showIdealFormation = input.bool(true, 'Ideal Formation', group = grpVisuals, inline = 'ideal')
showIdealLevel     = input.bool(true, 'PS Confirm Level', group = grpVisuals, inline = 'ideal')
idealBullColor     = input.color(color.new(color.green, 0), '', group = grpVisuals, inline = 'ideal')
idealBearColor     = input.color(color.new(color.red, 0), '', group = grpVisuals, inline = 'ideal')

grpTargets       = 'Targets'
targetMode       = input.string('Off', 'Target Mode', options = ['Off', 'Liquidity', 'Projection', 'Both'], group = grpTargets, inline = 'target', tooltip = 'Liquidity plots the nearest pre-existing confirmed HTF swing in the trade direction. Projection reuses the standard-deviation projection engine. Both shows both target types. Off preserves prior behavior.')
targetLookback   = input.int(30, 'Lookback', minval = 5, maxval = 100, group = grpTargets, inline = 'target')
targetExtendBars = input.int(30, 'Bars', minval = 5, maxval = 200, group = grpTargets, inline = 'target2')
targetColor      = input.color(color.new(color.blue, 0), 'Liquidity', group = grpTargets, inline = 'target2')
targetStyle      = input.string('Dashed', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpTargets, inline = 'target2')
targetWidth      = input.int(1, '', minval = 1, maxval = 5, group = grpTargets, inline = 'target2')

grpSession      = 'Session / Time Filter'
sessionFilter   = input.string('Off', 'Session', options = ['Off', 'London KZ', 'New York AM', 'New York PM', 'Custom'], group = grpSession, inline = 'session', tooltip = 'Optional setup-time filter. It gates only new C2/C3 setups at the qualifying HTF closure boundary and never deletes an already-created historical setup.')
customSession   = input.session('0930-1200', 'Custom', group = grpSession, inline = 'session2', active = sessionFilter == 'Custom')
customSessionTz = input.string('America/New_York', 'TZ', options = ['America/New_York', 'Europe/London', 'Etc/UTC', 'Asia/Singapore'], group = grpSession, inline = 'session2', active = sessionFilter == 'Custom')

grpStdDev   = 'Deviations'
showStdDev  = input.bool(false, 'Enable Projections?', group = grpStdDev, inline = 'stdb')
stdDevInput = input.string('-1,-2,-3', '', group = grpStdDev, inline = 'stdb', active = showStdDev or targetMode == 'Projection' or targetMode == 'Both')
stdDevCalc  = input.string('Wick', 'Method', options = ['Wick', 'Body'], group = grpStdDev, inline = 'stdb', active = showStdDev or targetMode == 'Projection' or targetMode == 'Both')
stdDevColor = input.color(color.new(#000000, 0), '', group = grpStdDev, inline = 'stdc', active = showStdDev or targetMode == 'Projection' or targetMode == 'Both')
stdDevStyle = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpStdDev, inline = 'stdc', active = showStdDev or targetMode == 'Projection' or targetMode == 'Both')
stdDevWidth = input.int(1, '', minval = 1, group = grpStdDev, inline = 'stdc', active = showStdDev or targetMode == 'Projection' or targetMode == 'Both')

grpDash  = 'Dashboard'
boolTable = input.bool(true, 'Show Dashboard', group = grpDash)
tableVert = input.string('Top', '', options = ['Top', 'Middle', 'Bottom'], inline = 'loc', group = grpDash)
tableHorz = input.string('Right', '', options = ['Left', 'Center', 'Right'], inline = 'loc', group = grpDash)
dashTextColor = input.color(color.new(#131722, 0), 'Text', group = grpDash, inline = 'color')
dashBgColor   = input.color(color.new(#ffffff, 0), 'Background', group = grpDash, inline = 'color')

//#endregion

//#region [CONSTANTS AND STATE]

requireCisdToShow = true
candleSpacing = 3
noColor       = color.new(#000000, 100)

type HtfCandle
    float o
    float h
    float l
    float c
    int   hBar
    int   lBar
    box   body
    line  wickUp
    line  wickDown
    line  eqLine
    int   midX
    line  sweepLine   = na
    bool  triggerBuy  = false
    bool  triggerSell = false

type PeriodState
    float prevOpen        = na
    float prevHigh        = na
    float prevLow         = na
    float prevClose       = na
    int   prevHighBar     = na
    int   prevLowBar      = na
    float prevPrevHigh    = na
    float prevPrevLow     = na
    int   prevPrevHighBar = na
    int   prevPrevLowBar  = na
    int   prevPrevPrevHighBar = na
    int   prevPrevPrevLowBar  = na
    bool  prevC2Buy       = false
    bool  prevC2Sell      = false
    bool  prevC3Buy       = false
    bool  prevC3Sell      = false

type StdDevData
    array<line>  lines
    array<label> labels

type C2Setup
    bool  isBull
    float extreme
    int   phase     = 1
    bool  dead      = false
    int   closureCandle = 2
    label c2Lbl     = na
    box   c3Box     = na
    line  c3Dash    = na
    float cisdLevel     = na
    int   cisdIndex     = na
    bool  cisdConfirmed = false
    line  cisdLine      = na
    label cisdLabel     = na
    StdDevData stdDevData = na
    box   c4Box     = na
    line  c4Dash    = na
    label c4Lbl     = na
    float c4Top     = na
    float c4Bottom  = na
    bool  c4Invalid = false
    // --- gating / deferred-draw bookkeeping ---
    bool  revealed          = false   // true once C2/C3/(C4) have actually been drawn
    int   c2Bar             = na
    float c2Price           = na
    float sweepFromPrice    = na
    int   sweepFromBar      = na
    int   c3StartBar        = na
    int   c4StartBar        = na
    float c3Top             = na
    float c3Bottom          = na
    // --- Ideal Formation / protected swing bookkeeping ---
    float protectedLevel    = na   // opening price of opposing HTF candle series
    bool  idealFormation    = false
    int   idealCandle       = na   // 2 or 3
    int   idealMarkBar      = na
    line  protectedLine     = na
    label idealLabel        = na
    // --- optional frozen liquidity target ---
    float liquidityTarget   = na
    line  targetLine        = na
    label targetLabel       = na

type SetupRecord
    C2Setup setup
    int     creationBar

type EarlyCisdRecord
    line  ln
    label lbl
    int   barIndex

var array<HtfCandle>        htfCandles           = array.new<HtfCandle>()
var array<line>             vLines               = array.new<line>()
var array<line>             hLines               = array.new<line>()
var array<line>             lLines               = array.new<line>()
var PeriodState              state                = PeriodState.new()
var C2Setup                  buySetup             = na
var C2Setup                  sellSetup            = na
var array<SetupRecord>       setupRecords         = array.new<SetupRecord>()
var array<EarlyCisdRecord>   bullEarlyCisdRecords = array.new<EarlyCisdRecord>()
var array<EarlyCisdRecord>   bearEarlyCisdRecords = array.new<EarlyCisdRecord>()
var int                      htfOpenBar           = na
var line                     htfOpenLn            = na

//#endregion

//#region [FUNCTIONS]

tfLabel(string tf) =>
    switch tf
        '1'   => '1m'
        '3'   => '3m'
        '5'   => '5m'
        '15'  => '15m'
        '60'  => '1h'
        '240' => '4h'
        '1D'  => '1D'
        'D'   => '1D'
        '1W'  => '1W'
        'W'   => '1W'
        '1M'  => '1M'
        'M'   => '1M'
        =>       tf + 'm'

tfMins(string tf) =>
    switch tf
        '1D' => 1440
        'D'  => 1440
        '1W' => 10080
        'W'  => 10080
        '1M' => 43200
        'M'  => 43200
        =>      int(str.tonumber(tf))

curTfCode() =>
    timeframe.isdaily ? '1D' : timeframe.isweekly ? '1W' : timeframe.ismonthly ? '1M' : timeframe.period

tablePosition(string vert, string horz) =>
    switch vert + '-' + horz
        'Top-Left'      => position.top_left
        'Top-Center'    => position.top_center
        'Top-Right'     => position.top_right
        'Middle-Left'   => position.middle_left
        'Middle-Center' => position.middle_center
        'Middle-Right'  => position.middle_right
        'Bottom-Left'   => position.bottom_left
        'Bottom-Center' => position.bottom_center
        'Bottom-Right'  => position.bottom_right
        =>                 position.top_right

lineStyleFromStr(string s) =>
    switch s
        'Solid'  => line.style_solid
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        =>          line.style_dashed

textSize(string s) =>
    switch s
        'Tiny'   => size.tiny
        'Small'  => size.small
        'Normal' => size.normal
        'Large'  => size.large
        =>          size.huge

directionalLabel(int xBar, float yPrice, string txt, bool bullish) =>
    label.new(xBar, yPrice, text = txt, xloc = xloc.bar_index, yloc = yloc.price, style = bullish ? label.style_label_up : label.style_label_down, color = na, textcolor = color.gray, size = textSize(labelSize), text_font_family = font.family_monospace)

eqLineColor() => showEQ ? eqColor : noColor

drawSweepLine(int fromBar, float fromPrice, int toBar) =>
    line ln = showSweep ? line.new(fromBar, fromPrice, toBar, fromPrice, color = sweepColor, style = lineStyleFromStr(sweepStyle), width = sweepWidth) : na
    ln

newLHLine(float price) =>
    line.new(bar_index, price, bar_index, price, xloc.bar_index, extend.none, lhColor, lineStyleFromStr(lhStyle), lhWidth)

updateLHLine(line ln, float price) =>
    line.set_xy1(ln, line.get_x1(ln), price)
    line.set_xy2(ln, bar_index, price)
    line.set_color(ln, lhColor)
    line.set_style(ln, lineStyleFromStr(lhStyle))
    line.set_width(ln, lhWidth)

autoHTF() =>
    switch timeframe.period
        '1'   => '15'
        '3'   => '30'
        '5'   => '60'
        '15'  => '240'
        '60'  => '1D'
        '240' => '1W'
        '1D'  => '1M'
        =>       '1M'

ltfCode() =>
    switch modelType
        '1m-15m' => '1'
        '3m-30m' => '3'
        '5m-1H'  => '5'
        '15m-4H' => '15'
        '1H-1D'  => '60'
        '4H-1W'  => '240'
        '1D-1W'  => '1D'
        'Custom' => customLTF
        =>          curTfCode()

isAutoValidTf(int mins) => mins == 1 or mins == 3 or mins == 5 or mins == 15 or mins == 60 or mins == 240 or mins == 1440

// Returns the next standard Fractal Model alignment above a selected HTF.
// Example: 5m-1H -> 15m-4H -> 1H-1D.
nextBiasPair(string htf) =>
    string nextLtf = ''
    string nextHtf = ''
    if htf == '15'
        nextLtf := '5'
        nextHtf := '60'
    else if htf == '30'
        // 3m-30m is an extra alignment in this open-source script. Its next
        // higher canonical Fractal Model is 5m-1H, not 15m-4H.
        nextLtf := '5'
        nextHtf := '60'
    else if htf == '60'
        nextLtf := '15'
        nextHtf := '240'
    else if htf == '240'
        nextLtf := '60'
        nextHtf := '1D'
    else if htf == '1D' or htf == 'D'
        nextLtf := '240'
        nextHtf := '1W'
    else if htf == '1W' or htf == 'W'
        nextLtf := '1D'
        nextHtf := '1M'
    [nextLtf, nextHtf]

// Compact non-drawing Fractal Model engine used only by Auto Bias.
// It executes in the reference model's LTF context via request.security().
// A confirmed C2 supplies bias through C3/C4; a true C3 supplies bias through
// C4. The model is neutral after its continuation window finishes or if its
// structural invalidation extreme is breached. All model changes occur from
// completed reference-HTF candles and strict same-candle CISD confirmation.
fractalBiasEngine(string refHtf) =>
    bool periodChanged = time(refHtf) != time(refHtf)[1]

    var float curO = na
    var float curH = na
    var float curL = na
    var float curC = na
    var float prevO1 = na
    var float prevH1 = na
    var float prevL1 = na
    var float prevC1 = na
    var float prevO2 = na
    var float prevH2 = na
    var float prevL2 = na
    var float prevC2 = na

    var float bullLevel = na
    var int   bullIndex = na
    var float bearLevel = na
    var int   bearIndex = na
    var bool  bullReclaimed = false
    var bool  bearReclaimed = false
    var int   bullLevelHtfTime = na
    var int   bearLevelHtfTime = na
    var int   bullReclaimHtfTime = na
    var int   bearReclaimHtfTime = na

    var int   biasDir = 0       // 1 bullish, -1 bearish, 0 neutral
    var int   modelPhase = 0    // 1 = C3, 2 = C4
    var float modelExtreme = na

    if na(curO)
        curO := open
        curH := high
        curL := low
        curC := close
    else if periodChanged
        // cur* is the HTF candle that has just completed. prev1/prev2 are the
        // two older completed HTF candles.
        float completedO = curO
        float completedH = curH
        float completedL = curL
        float completedC = curC

        bool c2Bull = not na(prevL1) and completedL < prevL1 and completedC > prevL1
        bool c2Bear = not na(prevH1) and completedH > prevH1 and completedC < prevH1
        bool c2BullContinuation = not na(prevL2) and prevL1 < prevL2 and prevC1 < prevL2
        bool c2BearContinuation = not na(prevH2) and prevH1 > prevH2 and prevC1 > prevH2
        bool c3Bull = c2BullContinuation and completedL >= prevL1 and completedC > completedO and completedC > math.max(prevO1, prevC1)
        bool c3Bear = c2BearContinuation and completedH <= prevH1 and completedC < completedO and completedC < math.min(prevO1, prevC1)

        int qualifyingHtfTime = time(refHtf)[1]
        bool strictBullCisd = bullReclaimed[1] and not na(bullLevelHtfTime[1]) and bullLevelHtfTime[1] == qualifyingHtfTime and bullReclaimHtfTime[1] == qualifyingHtfTime
        bool strictBearCisd = bearReclaimed[1] and not na(bearLevelHtfTime[1]) and bearLevelHtfTime[1] == qualifyingHtfTime and bearReclaimHtfTime[1] == qualifyingHtfTime

        // First advance/finish any existing model. A newly confirmed model on
        // this same boundary overrides the progressed state below.
        if modelPhase == 1
            modelPhase := 2
        else if modelPhase == 2
            modelPhase := 0
            biasDir := 0
            modelExtreme := na

        // Match the main engine's priority: C2 first, true C3 second, so a true
        // C3 can replace a simultaneous C2 classification on the same close.
        if c2Bull and strictBullCisd
            biasDir := 1
            modelPhase := 1
            modelExtreme := completedL
        if c2Bear and strictBearCisd
            biasDir := -1
            modelPhase := 1
            modelExtreme := completedH
        if c3Bull and strictBullCisd
            biasDir := 1
            modelPhase := 2
            modelExtreme := prevL1
        if c3Bear and strictBearCisd
            biasDir := -1
            modelPhase := 2
            modelExtreme := prevH1

        prevO2 := prevO1
        prevH2 := prevH1
        prevL2 := prevL1
        prevC2 := prevC1
        prevO1 := completedO
        prevH1 := completedH
        prevL1 := completedL
        prevC1 := completedC

        curO := open
        curH := high
        curL := low
        curC := close
    else
        curH := math.max(curH, high)
        curL := math.min(curL, low)
        curC := close

    // Detect the reference LTF opposing-candle series responsible for the
    // current reference-HTF sweep. This mirrors the strict CISD engine used by
    // the main model, but stores no drawings.
    bool up = close > open
    bool dw = close < open
    bool eq = close == open

    if not na(prevL1) and low == curL and low < prevL1
        if (dw or eq) and (close[1] > open[1] or close[1] == open[1]) and not (eq and close[1] == open[1])
            bullLevel := open
            bullIndex := bar_index
        else
            for i = 2 to 10
                if low[i] < low
                    break
                bool upI = close[i] > open[i]
                bool eqI = close[i] == open[i]
                bool dwPrev = close[i - 1] < open[i - 1]
                if (upI or eqI) and dwPrev
                    int b = i - 1
                    bullLevel := open[b]
                    bullIndex := bar_index - b
                    for j = b to 0
                        if open[j] > bullLevel and close[j] < open[j]
                            bullLevel := open[j]
                            bullIndex := bar_index - j
                    if bullLevel < open
                        bullLevel := close > open ? high : open
                        bullIndex := bar_index
                    break

    if not na(prevH1) and high == curH and high > prevH1
        if (up or eq) and (close[1] < open[1] or close[1] == open[1]) and not (eq and close[1] == open[1])
            bearLevel := open
            bearIndex := bar_index
        else
            for i = 2 to 10
                if high[i] > high
                    break
                bool dwI = close[i] < open[i]
                bool eqI = close[i] == open[i]
                bool upPrev = close[i - 1] > open[i - 1]
                if (dwI or eqI) and upPrev
                    int b = i - 1
                    bearLevel := open[b]
                    bearIndex := bar_index - b
                    for j = b to 0
                        if open[j] < bearLevel and close[j] > open[j]
                            bearLevel := open[j]
                            bearIndex := bar_index - j
                    if bearLevel > open
                        bearLevel := close < open ? low : open
                        bearIndex := bar_index
                    break

    bool newBullLevel = not na(bullIndex) and (na(bullIndex[1]) or bullIndex != bullIndex[1])
    if newBullLevel
        bullReclaimed := false
        bullReclaimHtfTime := na
        int bullOffset = bar_index - bullIndex
        bullLevelHtfTime := time(refHtf)[bullOffset]
    if barstate.isconfirmed and not na(bullLevel) and not bullReclaimed and close > bullLevel
        bullReclaimed := true
        bullReclaimHtfTime := time(refHtf)

    bool newBearLevel = not na(bearIndex) and (na(bearIndex[1]) or bearIndex != bearIndex[1])
    if newBearLevel
        bearReclaimed := false
        bearReclaimHtfTime := na
        int bearOffset = bar_index - bearIndex
        bearLevelHtfTime := time(refHtf)[bearOffset]
    if barstate.isconfirmed and not na(bearLevel) and not bearReclaimed and close < bearLevel
        bearReclaimed := true
        bearReclaimHtfTime := time(refHtf)

    // Structural invalidation is evaluated throughout the active higher HTF
    // candle. Because the engine is requested with lookahead_off, the outer
    // chart only receives this state after the reference LTF bar closes.
    if biasDir == 1 and not na(modelExtreme) and low < modelExtreme
        biasDir := 0
        modelPhase := 0
        modelExtreme := na
    if biasDir == -1 and not na(modelExtreme) and high > modelExtreme
        biasDir := 0
        modelPhase := 0
        modelExtreme := na

    biasDir

method delete(HtfCandle c) =>
    box.delete(c.body)
    line.delete(c.wickUp)
    line.delete(c.wickDown)
    line.delete(c.eqLine)
    line.delete(c.sweepLine)

method update(HtfCandle c, float curH, float curL, float curC, int curBar) =>
    if curH > c.h
        c.h    := curH
        c.hBar := curBar
    if curL < c.l
        c.l    := curL
        c.lBar := curBar
    c.c := curC
    c

method draw(HtfCandle c, int leftBar) =>
    bool  isBull = c.c >= c.o
    int   midX   = leftBar + 1
    float eq     = (c.h + c.l) / 2
    box.set_left(c.body, leftBar)
    box.set_right(c.body, leftBar + 2)
    box.set_top(c.body, math.max(c.o, c.c))
    box.set_bottom(c.body, math.min(c.o, c.c))
    box.set_bgcolor(c.body, isBull ? bullBody : bearBody)
    box.set_border_color(c.body, isBull ? borderBull : borderBear)
    line.set_x1(c.wickUp, midX)
    line.set_x2(c.wickUp, midX)
    line.set_y1(c.wickUp, c.h)
    line.set_y2(c.wickUp, math.max(c.o, c.c))
    line.set_color(c.wickUp, isBull ? wickBull : wickBear)
    line.set_x1(c.wickDown, midX)
    line.set_x2(c.wickDown, midX)
    line.set_y1(c.wickDown, c.l)
    line.set_y2(c.wickDown, math.min(c.o, c.c))
    line.set_color(c.wickDown, isBull ? wickBull : wickBear)
    line.set_x1(c.eqLine, midX)
    line.set_x2(c.eqLine, midX)
    line.set_y1(c.eqLine, eq)
    line.set_y2(c.eqLine, eq)
    line.set_color(c.eqLine, eqLineColor())
    line.set_style(c.eqLine, lineStyleFromStr(eqStyle))
    line.set_width(c.eqLine, eqWidth)
    c.midX := midX

newHtfCandle() =>
    HtfCandle.new(open, high, low, close, bar_index, bar_index,
         box.new(bar_index, high, bar_index, low, border_color = borderBull, border_width = 1),
         line.new(bar_index, high, bar_index, high, color = wickBull),
         line.new(bar_index, low, bar_index, low, color = wickBull),
         line.new(bar_index, high, bar_index, high, color = noColor),
         na)

drawEarlyCisd(bool isBull, float level, int idx, int confirmBar) =>
    array<EarlyCisdRecord> target = isBull ? bullEarlyCisdRecords : bearEarlyCisdRecords
    if showEarlyCisd
        ln = line.new(idx, level, confirmBar + 3, level, color = earlyCisdColor, style = lineStyleFromStr(earlyCisdStyle), width = earlyCisdWidth)
        label lbl = na
        if showLabels
            lbl := label.new(confirmBar + 3, level, isBull ? '+CISD' : '-CISD', xloc = xloc.bar_index, style = label.style_label_left, color = na, textcolor = earlyCisdColor, size = textSize(labelSize), text_font_family = font.family_monospace)
        target.push(EarlyCisdRecord.new(ln, lbl, confirmBar))
    if showAlerts and showEarlyCisdAlerts
        alert((isBull ? 'Bullish' : 'Bearish') + ' Early CISD confirmed on ' + syminfo.ticker, alert.freq_once_per_bar)

pruneEarlyCisd(array<EarlyCisdRecord> recs, int thresholdBar) =>
    if not na(thresholdBar)
        while recs.size() > 0 and recs.first().barIndex < thresholdBar
            evicted = recs.shift()
            line.delete(evicted.ln)
            if not na(evicted.lbl)
                label.delete(evicted.lbl)

consumeLastEarlyCisd(array<EarlyCisdRecord> recs) =>
    if recs.size() > 0
        evicted = recs.pop()
        line.delete(evicted.ln)
        if not na(evicted.lbl)
            label.delete(evicted.lbl)

parseFloats(string src) =>
    var out = array.new<float>()
    array.clear(out)
    for part in str.split(str.replace_all(src, ' ', ''), ',')
        v = str.tonumber(part)
        if not na(v)
            out.push(v)
    out

createStdDevProjections(C2Setup s, int confirmBar) =>
    if showStdDev or targetMode == 'Projection' or targetMode == 'Both'
        devs = parseFloats(stdDevInput)
        if devs.size() > 0
            off     = bar_index - s.cisdIndex
            useWick = stdDevCalc == 'Wick'

            level0 = s.cisdLevel
            level1 = s.extreme
            if not useWick
                for j = 0 to 50
                    if s.isBull ? low[j] == s.extreme : high[j] == s.extreme
                        level1 := s.isBull ? math.min(open[j], close[j]) : math.max(open[j], close[j])
                        break

            leftBar = s.cisdIndex
            if s.cisdIndex < bar_index
                prevBetter = s.isBull
                     ? (useWick ? high[off + 1] > high[off] : math.max(open[off + 1], close[off + 1]) > math.max(open[off], close[off]))
                     : (useWick ? low[off + 1]  < low[off]  : math.min(open[off + 1], close[off + 1]) < math.min(open[off], close[off]))
                if prevBetter
                    leftBar := s.cisdIndex - 1

            rightBar   = confirmBar + 3
            priceRange = s.isBull ? level0 - level1 : level1 - level0
            lns        = array.new<line>()
            lbs        = array.new<label>()

            for dev in devs
                devPrice = s.isBull ? level0 - priceRange * dev : level0 + priceRange * dev
                lns.push(line.new(leftBar, devPrice, rightBar, devPrice, xloc = xloc.bar_index, color = stdDevColor, width = stdDevWidth, style = lineStyleFromStr(stdDevStyle)))
                if showLabels
                    lbs.push(label.new(rightBar, devPrice, str.tostring(dev), xloc = xloc.bar_index, style = label.style_label_left, color = na, textcolor = stdDevColor, size = textSize(labelSize), text_font_family = font.family_monospace))

            s.stdDevData := StdDevData.new(lns, lbs)

drawLiquidityTarget(C2Setup s, int confirmBar) =>
    if (targetMode == 'Liquidity' or targetMode == 'Both') and not na(s.liquidityTarget)
        rightBar = confirmBar + targetExtendBars
        s.targetLine := line.new(confirmBar, s.liquidityTarget, rightBar, s.liquidityTarget, xloc = xloc.bar_index, color = targetColor, width = targetWidth, style = lineStyleFromStr(targetStyle))
        if showLabels
            s.targetLabel := label.new(rightBar, s.liquidityTarget, 'LQ TP', xloc = xloc.bar_index, style = label.style_label_left, color = na, textcolor = targetColor, size = textSize(labelSize), text_font_family = font.family_monospace)
    s

confirmCisd(C2Setup s, int confirmBar) =>
    s.cisdConfirmed := true
    showLine = s.isBull ? showBullCisd : showBearCisd
    clr      = s.isBull ? cisdBullColor : cisdBearColor
    lnStyle  = s.isBull ? cisdBullStyle : cisdBearStyle
    lnWidth  = s.isBull ? cisdBullWidth : cisdBearWidth
    if showLine
        s.cisdLine := line.new(s.cisdIndex, s.cisdLevel, confirmBar + 3, s.cisdLevel, color = clr, style = lineStyleFromStr(lnStyle), width = lnWidth)
        if showLabels
            s.cisdLabel := label.new(confirmBar + 3, s.cisdLevel, s.isBull ? '+CISD' : '-CISD', xloc = xloc.bar_index, style = label.style_label_left, color = na, textcolor = clr, size = textSize(labelSize), text_font_family = font.family_monospace)
    createStdDevProjections(s, confirmBar)
    drawLiquidityTarget(s, confirmBar)

deleteSetupVisuals(C2Setup s) =>
    if not na(s)
        if not na(s.c2Lbl)
            label.delete(s.c2Lbl)
        if not na(s.cisdLine)
            line.delete(s.cisdLine)
        if not na(s.cisdLabel)
            label.delete(s.cisdLabel)
        if not na(s.c3Box)
            box.delete(s.c3Box)
        if not na(s.c3Dash)
            line.delete(s.c3Dash)
        if not na(s.c4Box)
            box.delete(s.c4Box)
        if not na(s.c4Dash)
            line.delete(s.c4Dash)
        if not na(s.c4Lbl)
            label.delete(s.c4Lbl)
        if not na(s.protectedLine)
            line.delete(s.protectedLine)
        if not na(s.idealLabel)
            label.delete(s.idealLabel)
        if not na(s.targetLine)
            line.delete(s.targetLine)
        if not na(s.targetLabel)
            label.delete(s.targetLabel)
        if not na(s.stdDevData)
            if not na(s.stdDevData.lines)
                for ln in s.stdDevData.lines
                    line.delete(ln)
            if not na(s.stdDevData.labels)
                for lb in s.stdDevData.labels
                    label.delete(lb)

registerRecord(C2Setup s) =>
    setupRecords.push(SetupRecord.new(s, bar_index))
    while showHistory > 0 and setupRecords.size() > showHistory
        evicted = setupRecords.shift()
        deleteSetupVisuals(evicted.setup)
    earliestVisibleBar = setupRecords.size() > 0 ? setupRecords.first().creationBar : na
    pruneEarlyCisd(bullEarlyCisdRecords, earliestVisibleBar)
    pruneEarlyCisd(bearEarlyCisdRecords, earliestVisibleBar)

// Returns the opening-price level of the opposing HTF candle series that
// produced a swept swing. This mirrors the protected-swing concept used by
// TTFM: bullish swings must close above the down-close series; bearish swings
// must close below the up-close series. swingOffset=0 is the current HTF
// closure candle (C2); swingOffset=1 is the prior HTF candle (the swept C2
// when a true C3 closure is being evaluated).
protectedSeriesLevel(bool isBull, int swingOffset) =>
    float level = na
    if isBull
        swingLow = low[swingOffset]
        swingDw  = close[swingOffset] < open[swingOffset]
        swingEq  = close[swingOffset] == open[swingOffset]
        prevUp   = close[swingOffset + 1] > open[swingOffset + 1]
        prevEq   = close[swingOffset + 1] == open[swingOffset + 1]
        if (swingDw or swingEq) and (prevUp or prevEq) and not (swingEq and prevEq)
            level := open[swingOffset]
        else
            for i = swingOffset + 2 to swingOffset + 10
                if low[i] < swingLow
                    break
                upI     = close[i] > open[i]
                eqI     = close[i] == open[i]
                downPrev = close[i - 1] < open[i - 1]
                if (upI or eqI) and downPrev
                    b = i - 1
                    level := open[b]
                    for j = swingOffset to b
                        if close[j] < open[j] and open[j] > level
                            level := open[j]
                    break
    else
        swingHigh = high[swingOffset]
        swingUp   = close[swingOffset] > open[swingOffset]
        swingEq   = close[swingOffset] == open[swingOffset]
        prevDw    = close[swingOffset + 1] < open[swingOffset + 1]
        prevEq    = close[swingOffset + 1] == open[swingOffset + 1]
        if (swingUp or swingEq) and (prevDw or prevEq) and not (swingEq and prevEq)
            level := open[swingOffset]
        else
            for i = swingOffset + 2 to swingOffset + 10
                if high[i] > swingHigh
                    break
                downI  = close[i] < open[i]
                eqI    = close[i] == open[i]
                upPrev = close[i - 1] > open[i - 1]
                if (downI or eqI) and upPrev
                    b = i - 1
                    level := open[b]
                    for j = swingOffset to b
                        if close[j] > open[j] and open[j] < level
                            level := open[j]
                    break
    level

// Classifies the higher-timeframe point of interest touched by the qualifying
// sweep. 0=None, 1=FVG, 2=Swing liquidity, 3=Opposing candle. The scan starts
// from candles that were already complete before the sweep candle began, so a
// setup can never manufacture its own POI. setupOffset=0 evaluates C2; a true
// C3 uses setupOffset=1 because the actual liquidity sweep occurred in C2.
poiClass(bool isBull, int setupOffset, int lookback) =>
    int result = 0
    int prevOffset = setupOffset + 1
    float sweepA = isBull ? low[setupOffset] : high[prevOffset]
    float sweepB = isBull ? low[prevOffset] : high[setupOffset]
    float sweepLow = math.min(sweepA, sweepB)
    float sweepHigh = math.max(sweepA, sweepB)

    // FVG has first priority. A bullish reversal reacts to a bullish FVG;
    // bearish logic is mirrored. The sweep segment only needs to intersect the
    // pre-existing imbalance zone.
    for i = prevOffset to lookback
        if result == 0
            if isBull
                bool fvg = low[i] > high[i + 2]
                float zoneLow = high[i + 2]
                float zoneHigh = low[i]
                if fvg and sweepHigh >= zoneLow and sweepLow <= zoneHigh
                    result := 1
            else
                bool fvg = high[i] < low[i + 2]
                float zoneLow = high[i]
                float zoneHigh = low[i + 2]
                if fvg and sweepHigh >= zoneLow and sweepLow <= zoneHigh
                    result := 1

    // If no FVG exists on the sweep path, look for a confirmed 3-candle swing
    // high/low that was known before the sweep candle opened.
    if result == 0
        for i = prevOffset + 1 to lookback
            if result == 0
                if isBull
                    bool swingLow = low[i] < low[i + 1] and low[i] < low[i - 1]
                    if swingLow and low[i] >= sweepLow and low[i] <= sweepHigh
                        result := 2
                else
                    bool swingHigh = high[i] > high[i + 1] and high[i] > high[i - 1]
                    if swingHigh and high[i] >= sweepLow and high[i] <= sweepHigh
                        result := 2

    // Course fallback: when neither an FVG nor a swing is present, an older
    // opposing-candle body can serve as the POI. C1 itself is excluded so that
    // every reversal is not automatically classified as an opposing-candle POI.
    if result == 0
        for i = prevOffset + 1 to lookback
            if result == 0
                bool opposing = isBull ? close[i] < open[i] : close[i] > open[i]
                float zoneLow = math.min(open[i], close[i])
                float zoneHigh = math.max(open[i], close[i])
                if opposing and sweepHigh >= zoneLow and sweepLow <= zoneHigh
                    result := 3
    result

poiMatches(int cls) =>
    poiFilter == 'Off' or (poiFilter == 'Any POI' and cls > 0) or (poiFilter == 'FVG' and cls == 1) or (poiFilter == 'Swing' and cls == 2) or (poiFilter == 'Opposing Candle' and cls == 3)

poiLabel(int cls) =>
    cls == 1 ? 'FVG' : cls == 2 ? 'Swing' : cls == 3 ? 'Opp Candle' : 'None'

// Nearest pre-existing confirmed HTF swing liquidity in the trade direction.
// A pivot requires both neighboring candles to be completed before the setup
// candle begins. The chosen level is frozen when the setup is created.
liquidityTargetLevel(bool isBull, int setupSpan, int lookback) =>
    float barrier = isBull ? high : low
    if setupSpan > 0
        for j = 1 to setupSpan
            barrier := isBull ? math.max(barrier, high[j]) : math.min(barrier, low[j])
    float target = na
    for i = 2 to lookback
        if isBull
            bool pivotHigh = high[i] > high[i + 1] and high[i] > high[i - 1]
            if pivotHigh and high[i] > barrier and (na(target) or high[i] < target)
                target := high[i]
        else
            bool pivotLow = low[i] < low[i + 1] and low[i] < low[i - 1]
            if pivotLow and low[i] < barrier and (na(target) or low[i] > target)
                target := low[i]
    target

activeSessionSpec() =>
    string sess = ''
    string tz = 'America/New_York'
    if sessionFilter == 'London KZ'
        sess := '0200-0500:23456'
        tz := 'America/New_York'
    else if sessionFilter == 'New York AM'
        sess := '0930-1200:23456'
        tz := 'America/New_York'
    else if sessionFilter == 'New York PM'
        sess := '1330-1600:23456'
        tz := 'America/New_York'
    else if sessionFilter == 'Custom'
        sess := customSession
        tz := customSessionTz
    [sess, tz]

[activeSession, activeSessionTz] = activeSessionSpec()
sessionAllowsSetup = sessionFilter == 'Off' ? true : not na(time(timeframe.period, activeSession, activeSessionTz))

autoTf = switch modelType
    '1m-15m' => '15'
    '3m-30m' => '30'
    '5m-1H'  => '60'
    '15m-4H' => '240'
    '1H-1D'  => '1D'
    '4H-1W'  => '1W'
    '1D-1W'  => '1W'
    'Custom' => customHTF
    =>          autoHTF()

[biasLtf1, biasHtf1] = nextBiasPair(autoTf)
[biasLtf2, biasHtf2] = nextBiasPair(biasHtf1)

isAutoBias1 = biasFilter == 'Auto Bias 1'
isAutoBias2 = biasFilter == 'Auto Bias 2'
isAutoConfluence = biasFilter == 'Auto Bias Confluence'
selectedBiasLtf = isAutoBias1 ? biasLtf1 : isAutoBias2 ? biasLtf2 : ''
selectedBiasHtf = isAutoBias1 ? biasHtf1 : isAutoBias2 ? biasHtf2 : ''

// Auto Bias 1/2 keep the Task-4 selected-engine-only optimization. Confluence
// intentionally evaluates both higher Fractal Models because agreement between
// those two independent structures is the filter. Each engine remains bounded
// and uses lookahead_off so no future higher-fractal state is exposed.
int autoBias1Dir = 0
int autoBias2Dir = 0
if (isAutoBias1 or isAutoConfluence) and biasLtf1 != '' and biasHtf1 != ''
    autoBias1Dir := request.security(syminfo.tickerid, biasLtf1, fractalBiasEngine(biasHtf1), lookahead = barmerge.lookahead_off, calc_bars_count = 300)
if (isAutoBias2 or isAutoConfluence) and biasLtf2 != '' and biasHtf2 != ''
    autoBias2Dir := request.security(syminfo.tickerid, biasLtf2, fractalBiasEngine(biasHtf2), lookahead = barmerge.lookahead_off, calc_bars_count = 300)

confluenceBiasDir = autoBias1Dir == 1 and autoBias2Dir == 1 ? 1 : autoBias1Dir == -1 and autoBias2Dir == -1 ? -1 : 0
selectedAutoBiasDir = isAutoBias1 ? autoBias1Dir : isAutoBias2 ? autoBias2Dir : isAutoConfluence ? confluenceBiasDir : 0

// Manual behavior remains unchanged. Single Auto modes require their selected
// higher model. Confluence is stricter: both higher models must be active and
// point in the same direction; disagreement or Neutral on either side blocks
// new lower-fractal setups.
allowBuy = biasFilter == 'Neutral' or biasFilter == 'Bullish' or ((isAutoBias1 or isAutoBias2) and selectedAutoBiasDir == 1) or (isAutoConfluence and confluenceBiasDir == 1)
allowSell = biasFilter == 'Neutral' or biasFilter == 'Bearish' or ((isAutoBias1 or isAutoBias2) and selectedAutoBiasDir == -1) or (isAutoConfluence and confluenceBiasDir == -1)

validTf = modelType == 'Auto' ? isAutoValidTf(tfMins(curTfCode())) : tfMins(curTfCode()) <= tfMins(ltfCode())

[currentO, currentH, currentL, currentC, prevO1, prevH1, prevL1, prevC1, prevO2, prevH2, prevL2, prevC2] = request.security(syminfo.tickerid, autoTf, [open[0], high[0], low[0], close[0], open[1], high[1], low[1], close[1], open[2], high[2], low[2], close[2]], lookahead = barmerge.lookahead_on)

// Protected-series levels are calculated in the HTF context. C2 uses the
// current HTF candle as the swept swing; true C3 uses the prior HTF C2 swing.
[bullProtectedC2, bearProtectedC2, bullProtectedC3, bearProtectedC3] = request.security(syminfo.tickerid, autoTf, [protectedSeriesLevel(true, 0), protectedSeriesLevel(false, 0), protectedSeriesLevel(true, 1), protectedSeriesLevel(false, 1)], lookahead = barmerge.lookahead_on)

// POI context is calculated in the HTF itself, then consumed only with [1] on
// periodChanged below. That freezes the classification to the candle that just
// closed and prevents a live setup from gaining/losing POI status intrabar.
[bullPoiC2, bearPoiC2, bullPoiC3, bearPoiC3] = request.security(syminfo.tickerid, autoTf, [poiClass(true, 0, poiLookback), poiClass(false, 0, poiLookback), poiClass(true, 1, poiLookback), poiClass(false, 1, poiLookback)], lookahead = barmerge.lookahead_on)

// Liquidity objectives are computed in the HTF context and frozen from the
// just-closed qualifying candle with [1] at setup creation.
[bullLiquidityTargetC2, bearLiquidityTargetC2, bullLiquidityTargetC3, bearLiquidityTargetC3] = request.security(syminfo.tickerid, autoTf, [liquidityTargetLevel(true, 0, targetLookback), liquidityTargetLevel(false, 0, targetLookback), liquidityTargetLevel(true, 1, targetLookback), liquidityTargetLevel(false, 1, targetLookback)], lookahead = barmerge.lookahead_on)

c2Buy         = currentL < prevL1 and currentC > prevL1
c2Sell        = currentH > prevH1 and currentC < prevH1

// True Candle 3 Closure (TTFM): Candle 2 first produces a continuation
// closure through Candle 1 instead of a reversal closure. Candle 3 then
// reverses without extending the Candle 2 extreme and closes through the
// full body of Candle 2. The next HTF candle is therefore Candle 4.
c2BullContinuation = prevL1 < prevL2 and prevC1 < prevL2
c2BearContinuation = prevH1 > prevH2 and prevC1 > prevH2
c3Buy = c2BullContinuation and currentL >= prevL1 and currentC > currentO and currentC > math.max(prevO1, prevC1)
c3Sell = c2BearContinuation and currentH <= prevH1 and currentC < currentO and currentC < math.min(prevO1, prevC1)

periodChanged = time(autoTf) != time(autoTf)[1]

// Computes a non-repainting T-Spot from a COMPLETED HTF source candle.
// The source candle is C2 while C3 is printing, and C3 while C4 is printing.
// Bearish: source close -> midpoint(high, close).
// Bullish: midpoint(close, low) -> source close.
// No value from the currently-printing HTF candle is used.
computeTSpot(bool isBull, float srcHigh, float srcLow, float srcClose) =>
    mid = isBull ? (srcClose + srcLow) / 2 : (srcHigh + srcClose) / 2
    top = isBull ? srcClose : mid
    bot = isBull ? mid : srcClose
    [top, bot]

// Draws a phase T-Spot from already-frozen prices. Phase visuals are created
// at the HTF boundary, not retroactively when CISD confirms.
drawPhaseVisual(bool isBull, bool isC4, int startBar, float top, float bot, bool drawC4Label) =>
    yDash = isBull ? bot : top
    bxCol = isBull ? tSpotBullColor : tSpotBearColor
    box   bx   = showTSpot ? box.new(startBar, top, bar_index, bot, border_color = na, bgcolor = bxCol) : na
    line  dash = showEQ ? line.new(startBar, yDash, bar_index, yDash, color = eqColor, width = eqWidth, style = lineStyleFromStr(eqStyle)) : na
    label lbl  = na
    if drawC4Label and isC4 and showTSpot and showLabels and validTf
        lbl := directionalLabel(startBar + 2, isBull ? bot : top, 'C4', isBull)
    [bx, dash, lbl]

method drawIdeal(C2Setup s) =>
    if s.idealFormation and s.revealed and showIdealFormation and not na(s.protectedLevel)
        clr = s.isBull ? idealBullColor : idealBearColor
        if showIdealLevel and na(s.protectedLine)
            s.protectedLine := line.new(s.idealMarkBar, s.protectedLevel, bar_index, s.protectedLevel, xloc = xloc.bar_index, color = clr, width = 2)
        if showLabels and validTf and na(s.idealLabel)
            txt = 'IF C' + str.tostring(s.idealCandle)
            s.idealLabel := label.new(s.idealMarkBar, s.protectedLevel, txt, xloc = xloc.bar_index, style = s.isBull ? label.style_label_up : label.style_label_down, color = na, textcolor = clr, size = textSize(labelSize), text_font_family = font.family_monospace)
    s

method markIdeal(C2Setup s, int candleNo, int markBar) =>
    if not s.idealFormation and not na(s.protectedLevel)
        s.idealFormation := true
        s.idealCandle    := candleNo
        s.idealMarkBar   := markBar
        if s.revealed
            s.drawIdeal()
    s

// CISD reveal now controls confirmation labels/sweep only. T-Spot phase
// visuals are intentionally created at the confirmed HTF boundary so they
// never appear retroactively after CISD confirms.
method reveal(C2Setup s) =>
    if not s.revealed
        s.revealed := true
        if validTf and showLabels and not na(s.c2Bar)
            closureText = s.closureCandle == 3 ? 'C3' : 'C2'
            s.c2Lbl := directionalLabel(s.c2Bar, s.c2Price, closureText, s.isBull)
        if not na(s.sweepFromBar)
            drawSweepLine(s.sweepFromBar, s.sweepFromPrice, bar_index)
        if s.phase == 2 and not na(s.c4StartBar) and na(s.c4Lbl) and showTSpot and showLabels and validTf
            s.c4Lbl := directionalLabel(s.c4StartBar + 2, s.isBull ? s.c4Bottom : s.c4Top, 'C4', s.isBull)
        s.drawIdeal()
    s

newSetup(bool isBull, int closureCandle, float invalidationExtreme, int closureBar, float closurePrice, float sweepFromPrice, int sweepFromBar, float cisdLevel, int cisdIndex, bool cisdAlreadyConfirmed, int cisdConfirmBar, float protectedLevel, bool idealAtClosure, float liquidityTarget) =>
    startPhase = closureCandle == 3 ? 2 : 1
    s = C2Setup.new(isBull, invalidationExtreme, startPhase, false, closureCandle)
    s.c2Bar          := closureBar
    s.c2Price        := closurePrice
    s.sweepFromPrice := sweepFromPrice
    s.sweepFromBar   := sweepFromBar
    // periodChanged has already frozen state.prev* to the completed closure
    // candle, so these T-Spot bounds cannot change while C3/C4 is printing.
    [top, bot] = computeTSpot(isBull, state.prevHigh, state.prevLow, state.prevClose)
    if closureCandle == 3
        s.c4StartBar := bar_index
        s.c4Top      := top
        s.c4Bottom   := bot
        s.c4Invalid  := false
        [bx4, dash4, lbl4] = drawPhaseVisual(isBull, true, s.c4StartBar, top, bot, not requireCisdToShow)
        s.c4Box  := bx4
        s.c4Dash := dash4
        s.c4Lbl  := lbl4
    else
        s.c3StartBar := bar_index
        s.c3Top      := top
        s.c3Bottom   := bot
        [bx3, dash3, _] = drawPhaseVisual(isBull, false, s.c3StartBar, top, bot, false)
        s.c3Box  := bx3
        s.c3Dash := dash3
    s.cisdLevel       := cisdLevel
    s.cisdIndex       := cisdIndex
    s.protectedLevel  := protectedLevel
    s.liquidityTarget := liquidityTarget
    if idealAtClosure
        s.idealFormation := true
        s.idealCandle    := closureCandle
        s.idealMarkBar   := bar_index
    cisdReady = cisdAlreadyConfirmed and not na(cisdLevel) and not na(cisdIndex) and not na(cisdConfirmBar)
    if not requireCisdToShow
        // legacy behavior: always visible immediately
        s.reveal()
    if cisdReady
        if requireCisdToShow
            s.reveal()
        confirmCisd(s, cisdConfirmBar)
    registerRecord(s)
    s

method advanceToC4(C2Setup s) =>
    if not na(s.c3Box)
        box.set_right(s.c3Box, bar_index)
    if not na(s.c3Dash)
        line.set_x2(s.c3Dash, bar_index)
    s.c4StartBar := bar_index
    // A valid C2 can become Ideal on C3 when C3 completes the protected-swing
    // break through the stored opposing-series opening level. This is distinct
    // from a true C3 closure: the original C2 reversal remains the active model.
    if not s.idealFormation and not na(s.protectedLevel)
        directionalC3 = s.isBull ? state.prevClose > state.prevOpen : state.prevClose < state.prevOpen
        protectsSwing = s.isBull ? state.prevClose > s.protectedLevel : state.prevClose < s.protectedLevel
        if directionalC3 and protectsSwing
            s.markIdeal(3, bar_index)
    // At the C4 boundary state.prev* is the now-completed C3 candle.
    [top, bot] = computeTSpot(s.isBull, state.prevHigh, state.prevLow, state.prevClose)
    s.c4Top    := top
    s.c4Bottom := bot
    [bx, dash, lbl] = drawPhaseVisual(s.isBull, true, s.c4StartBar, top, bot, s.revealed)
    s.c4Box  := bx
    s.c4Dash := dash
    s.c4Lbl  := lbl
    s.phase     := 2
    s.c4Invalid := false
    s

method finish(C2Setup s) =>
    if not na(s.c4Box)
        box.set_right(s.c4Box, bar_index)
    if not na(s.c4Dash)
        line.set_x2(s.c4Dash, bar_index)
    s.phase := 0
    s

method deleteStdDev(C2Setup s) =>
    if not na(s.stdDevData)
        if not na(s.stdDevData.lines)
            for ln in s.stdDevData.lines
                line.delete(ln)
        if not na(s.stdDevData.labels)
            for lb in s.stdDevData.labels
                label.delete(lb)
        s.stdDevData := na
    s

method extendAndCheck(C2Setup s) =>
    if not na(s) and not s.dead and s.phase != 0
        box  extBox  = s.phase == 1 ? s.c3Box : s.c4Box
        line extDash = s.phase == 1 ? s.c3Dash : s.c4Dash
        if not na(extBox)
            box.set_right(extBox, bar_index)
        if not na(extDash)
            line.set_x2(extDash, bar_index)
        if not na(s.protectedLine)
            line.set_x2(s.protectedLine, bar_index)

        closureBreach = s.isBull ? low < s.extreme : high > s.extreme
        if closureBreach
            if not na(s.c2Lbl)
                label.set_text(s.c2Lbl, s.closureCandle == 3 ? 'XC3' : 'XC2')
                label.set_textcolor(s.c2Lbl, s.phase == 2 ? color.orange : color.red)
            // Preserve already-created T-Spot/EQ phase visuals. Removing them
            // after a later invalidation makes historical zones disappear and
            // looks like repainting. The setup is marked dead instead.
            if not na(s.c3Box)
                box.set_right(s.c3Box, bar_index)
            if not na(s.c3Dash)
                line.set_x2(s.c3Dash, bar_index)
            if not na(s.c4Box)
                box.set_right(s.c4Box, bar_index)
            if not na(s.c4Dash)
                line.set_x2(s.c4Dash, bar_index)
            if not na(s.c4Lbl)
                label.set_text(s.c4Lbl, 'XC4')
                label.set_textcolor(s.c4Lbl, color.red)
            s.deleteStdDev()
            s.dead  := true
            s.phase := 0
    s

// C4 invalidation may invalidate the model, but phase T-Spot history is kept.
// This avoids deleting already-visible zones after the fact (visual repaint).
method checkC4Invalid(C2Setup s) =>
    if not na(s) and not s.dead and s.phase == 2 and not s.c4Invalid
        invalid = s.isBull ? close[1] < s.c4Bottom : close[1] > s.c4Top
        if invalid
            s.c4Invalid := true
            if not na(s.c4Lbl)
                label.set_text(s.c4Lbl, 'XC4')
                label.set_textcolor(s.c4Lbl, color.red)
            if not na(s.c4Dash)
                line.set_color(s.c4Dash, color.red)
    s

processC2(bool trigger, bool allow, bool isBull, float extremePrice, int extremeBar, float sweepFromPrice, int sweepFromBar, float cisdLevel, int cisdIndex, bool cisdAlreadyConfirmed, int cisdConfirmBar, float protectedLevel, bool idealAtClosure, float liquidityTarget, C2Setup existing) =>
    C2Setup result = existing
    if trigger and allow
        result := newSetup(isBull, 2, extremePrice, extremeBar, extremePrice, sweepFromPrice, sweepFromBar, cisdLevel, cisdIndex, cisdAlreadyConfirmed, cisdConfirmBar, protectedLevel, idealAtClosure, liquidityTarget)
    else if periodChanged and not na(existing) and not existing.dead
        result := existing.phase == 1 ? existing.advanceToC4() : existing.phase == 2 ? existing.finish() : existing
    result

// Creates a distinct Candle 3 Closure setup. Unlike processC2(), this does
// not advance an existing setup: it only replaces it when a true C3 closure
// has just completed. A C3 closure starts directly in the C4 phase.
processC3(bool trigger, bool allow, bool isBull, float invalidationExtreme, int closureBar, float closurePrice, float sweepFromPrice, int sweepFromBar, float cisdLevel, int cisdIndex, bool cisdAlreadyConfirmed, int cisdConfirmBar, float protectedLevel, bool idealAtClosure, float liquidityTarget, C2Setup existing) =>
    C2Setup result = existing
    if trigger and allow
        result := newSetup(isBull, 3, invalidationExtreme, closureBar, closurePrice, sweepFromPrice, sweepFromBar, cisdLevel, cisdIndex, cisdAlreadyConfirmed, cisdConfirmBar, protectedLevel, idealAtClosure, liquidityTarget)
    result

markTrigger(bool trigger, bool allow, int idx, bool isBuy) =>
    if trigger and allow and htfCandles.size() > idx
        c = htfCandles.get(idx)
        if isBuy
            c.triggerBuy := true
        else
            c.triggerSell := true

//#endregion

//#region [LOGIC]

var float o0 = open
var float h0 = high
var float l0 = low
var float o1 = open
var float h1 = high
var float l1 = low

if periodChanged
    o1 := o0[1]
    h1 := h0[1]
    l1 := l0[1]
    o0 := open
    h0 := high
    l0 := low

if high >= h0
    h0 := high
if low <= l0
    l0 := low

bool up = close > open
bool dw = close < open
bool eq = close == open

var float bullLevelFixed = na
var int   bullIndexFixed = na
var float bearLevelFixed = na
var int   bearIndexFixed = na

if low == l0 and low < l1
    if (dw[0] or eq[0]) and (up[1] or eq[1]) and not (eq[0] and eq[1])
        bullLevelFixed := open
        bullIndexFixed := bar_index
    else
        for i = 2 to 10
            if low[i] < low
                break
            if (up[i] or eq[i]) and dw[i - 1]
                b = i - 1
                bullLevelFixed := open[b]
                bullIndexFixed := bar_index - b
                for j = b to 0
                    if open[j] > bullLevelFixed and dw[j]
                        bullLevelFixed := open[j]
                        bullIndexFixed := bar_index - j
                if bullLevelFixed < open
                    bullLevelFixed := close > open ? high : open
                    bullIndexFixed := bar_index
                break

if high == h0 and high > h1
    if (up[0] or eq[0]) and (dw[1] or eq[1]) and not (eq[0] and eq[1])
        bearLevelFixed := open
        bearIndexFixed := bar_index
    else
        for i = 2 to 10
            if high[i] > high
                break
            if (dw[i] or eq[i]) and up[i - 1]
                yb = i - 1
                bearLevelFixed := open[yb]
                bearIndexFixed := bar_index - yb
                for j = yb to 0
                    if open[j] < bearLevelFixed and up[j]
                        bearLevelFixed := open[j]
                        bearIndexFixed := bar_index - j
                if bearLevelFixed > open
                    bearLevelFixed := close < open ? low : open
                    bearIndexFixed := bar_index
                break

var bool bullReclaimed       = false
var int  bullReclaimBar      = na
var int  bullLevelHtfTime    = na
var int  bullReclaimHtfTime  = na
var bool bearReclaimed       = false
var int  bearReclaimBar      = na
var int  bearLevelHtfTime    = na
var int  bearReclaimHtfTime  = na

bullPeriodSweep = l0 < l1
bearPeriodSweep = h0 > h1

newBullLevel = not na(bullIndexFixed) and (na(bullIndexFixed[1]) or bullIndexFixed != bullIndexFixed[1])
if newBullLevel
    bullReclaimed      := false
    bullReclaimBar     := na
    bullReclaimHtfTime := na
    bullLevelOffset     = bar_index - bullIndexFixed
    bullLevelHtfTime   := time(autoTf)[bullLevelOffset]
// Confirm on the actual closed LTF bar. Using close[1] delayed the event by one
// LTF bar and could operationally move a final-bar CISD into the next HTF candle.
if barstate.isconfirmed and not na(bullLevelFixed) and not bullReclaimed and close > bullLevelFixed
    bullReclaimed      := true
    bullReclaimBar     := bar_index
    bullReclaimHtfTime := time(autoTf)
    if bullPeriodSweep
        drawEarlyCisd(true, bullLevelFixed, bullIndexFixed, bar_index)

newBearLevel = not na(bearIndexFixed) and (na(bearIndexFixed[1]) or bearIndexFixed != bearIndexFixed[1])
if newBearLevel
    bearReclaimed      := false
    bearReclaimBar     := na
    bearReclaimHtfTime := na
    bearLevelOffset     = bar_index - bearIndexFixed
    bearLevelHtfTime   := time(autoTf)[bearLevelOffset]
if barstate.isconfirmed and not na(bearLevelFixed) and not bearReclaimed and close < bearLevelFixed
    bearReclaimed      := true
    bearReclaimBar     := bar_index
    bearReclaimHtfTime := time(autoTf)
    if bearPeriodSweep
        drawEarlyCisd(false, bearLevelFixed, bearIndexFixed, bar_index)

candleOffset = candleOffsetIn + 10

if periodChanged
    if htfCandles.size() > 0
        newest             = htfCandles.first()
        state.prevOpen    := newest.o
        state.prevHigh    := newest.h
        state.prevLow     := newest.l
        state.prevClose   := newest.c
        state.prevHighBar := newest.hBar
        state.prevLowBar  := newest.lBar
    if htfCandles.size() > 1
        prior                  = htfCandles.get(1)
        state.prevPrevHigh    := prior.h
        state.prevPrevLow     := prior.l
        state.prevPrevHighBar := prior.hBar
        state.prevPrevLowBar  := prior.lBar
    if htfCandles.size() > 2
        prior2                      = htfCandles.get(2)
        state.prevPrevPrevHighBar := prior2.hBar
        state.prevPrevPrevLowBar  := prior2.lBar
    htfCandles.unshift(newHtfCandle())
    while htfCandles.size() > htfCandleCount
        htfCandles.pop().delete()
    htfOpenBar := bar_index
    if showLH
        if hLines.size() > 0
            line.set_x2(hLines.first(), bar_index)
            line.set_x2(lLines.first(), bar_index)
        hLines.unshift(newLHLine(high))
        lLines.unshift(newLHLine(low))
        while hLines.size() > htfCandleCount
            line.delete(hLines.pop())
        while lLines.size() > htfCandleCount
            line.delete(lLines.pop())
else if htfCandles.size() > 0
    htfCandles.set(0, htfCandles.first().update(high, low, close, bar_index))

if showLH and htfCandles.size() > 0 and hLines.size() > 0
    curCandle = htfCandles.first()
    updateLHLine(hLines.first(), curCandle.h)
    updateLHLine(lLines.first(), curCandle.l)

if periodChanged
    state.prevC2Buy  := c2Buy[1]
    state.prevC2Sell := c2Sell[1]
    state.prevC3Buy  := c3Buy[1]
    state.prevC3Sell := c3Sell[1]

c2BuyTrigger  = periodChanged and state.prevC2Buy
c2SellTrigger = periodChanged and state.prevC2Sell
c3BuyTrigger  = periodChanged and state.prevC3Buy
c3SellTrigger = periodChanged and state.prevC3Sell

// Course-aligned strict CISD ownership: the CISD level and its confirming close
// must both belong to the HTF candle that just closed. A prior or later HTF
// candle's CISD cannot validate this C2/C3 closure retroactively.
qualifyingHtfTime = periodChanged ? time(autoTf)[1] : na
bullStrictCisd = periodChanged and bullReclaimed[1] and not na(bullReclaimBar[1]) and bullLevelHtfTime[1] == qualifyingHtfTime and bullReclaimHtfTime[1] == qualifyingHtfTime
bearStrictCisd = periodChanged and bearReclaimed[1] and not na(bearReclaimBar[1]) and bearLevelHtfTime[1] == qualifyingHtfTime and bearReclaimHtfTime[1] == qualifyingHtfTime

bullSetupCisdLevel = bullStrictCisd ? bullLevelFixed[1] : na
bullSetupCisdIndex = bullStrictCisd ? bullIndexFixed[1] : na
bullSetupCisdBar   = bullStrictCisd ? bullReclaimBar[1] : na
bearSetupCisdLevel = bearStrictCisd ? bearLevelFixed[1] : na
bearSetupCisdIndex = bearStrictCisd ? bearIndexFixed[1] : na
bearSetupCisdBar   = bearStrictCisd ? bearReclaimBar[1] : na

// Freeze the protected-swing series level from the just-completed HTF candle.
// C2 stores this even when it is not yet Ideal so C3 can complete the break.
bullC2ProtectedLevel = c2BuyTrigger  ? bullProtectedC2[1] : na
bearC2ProtectedLevel = c2SellTrigger ? bearProtectedC2[1] : na
bullC3ProtectedLevel = c3BuyTrigger  ? bullProtectedC3[1] : na
bearC3ProtectedLevel = c3SellTrigger ? bearProtectedC3[1] : na

c2BuyIdeal  = c2BuyTrigger  and state.prevClose > state.prevOpen and not na(bullC2ProtectedLevel) and state.prevClose > bullC2ProtectedLevel
c2SellIdeal = c2SellTrigger and state.prevClose < state.prevOpen and not na(bearC2ProtectedLevel) and state.prevClose < bearC2ProtectedLevel
c3BuyIdeal  = c3BuyTrigger  and not na(bullC3ProtectedLevel) and state.prevClose > bullC3ProtectedLevel
c3SellIdeal = c3SellTrigger and not na(bearC3ProtectedLevel) and state.prevClose < bearC3ProtectedLevel

// Freeze the POI classification from the same just-closed HTF setup candle.
// True C3 deliberately uses the C2 sweep classification returned by poiClass(..., 1).
int bullC2PoiClass = c2BuyTrigger  ? nz(bullPoiC2[1], 0) : 0
int bearC2PoiClass = c2SellTrigger ? nz(bearPoiC2[1], 0) : 0
int bullC3PoiClass = c3BuyTrigger  ? nz(bullPoiC3[1], 0) : 0
int bearC3PoiClass = c3SellTrigger ? nz(bearPoiC3[1], 0) : 0

// Freeze the liquidity objective from the same completed HTF setup candle.
float bullC2SetupTarget = c2BuyTrigger  ? bullLiquidityTargetC2[1] : na
float bearC2SetupTarget = c2SellTrigger ? bearLiquidityTargetC2[1] : na
float bullC3SetupTarget = c3BuyTrigger  ? bullLiquidityTargetC3[1] : na
float bearC3SetupTarget = c3SellTrigger ? bearLiquidityTargetC3[1] : na

c2BuyAllow  = allowBuy  and poiMatches(bullC2PoiClass) and sessionAllowsSetup
c2SellAllow = allowSell and poiMatches(bearC2PoiClass) and sessionAllowsSetup
c3BuyAllow  = allowBuy  and poiMatches(bullC3PoiClass) and sessionAllowsSetup
c3SellAllow = allowSell and poiMatches(bearC3PoiClass) and sessionAllowsSetup

if ((c2BuyTrigger and c2BuyAllow) or (c3BuyTrigger and c3BuyAllow)) and bullStrictCisd
    consumeLastEarlyCisd(bullEarlyCisdRecords)

if ((c2SellTrigger and c2SellAllow) or (c3SellTrigger and c3SellAllow)) and bearStrictCisd
    consumeLastEarlyCisd(bearEarlyCisdRecords)

buySetup  := processC2(c2BuyTrigger, c2BuyAllow, true, state.prevLow, state.prevLowBar, state.prevPrevLow, state.prevPrevLowBar, bullSetupCisdLevel, bullSetupCisdIndex, bullStrictCisd, bullSetupCisdBar, bullC2ProtectedLevel, c2BuyIdeal, bullC2SetupTarget, buySetup)
sellSetup := processC2(c2SellTrigger, c2SellAllow, false, state.prevHigh, state.prevHighBar, state.prevPrevHigh, state.prevPrevHighBar, bearSetupCisdLevel, bearSetupCisdIndex, bearStrictCisd, bearSetupCisdBar, bearC2ProtectedLevel, c2SellIdeal, bearC2SetupTarget, sellSetup)

// A true C3 closure uses Candle 2's extreme as the structural invalidation,
// labels Candle 3 itself, and immediately opens the Candle 4 continuation
// phase. Candle 1 remains the sweep/reference level for the formation.
buySetup  := processC3(c3BuyTrigger, c3BuyAllow, true, prevL1[1], state.prevLowBar, currentL[1], prevL2[1], state.prevPrevPrevLowBar, bullSetupCisdLevel, bullSetupCisdIndex, bullStrictCisd, bullSetupCisdBar, bullC3ProtectedLevel, c3BuyIdeal, bullC3SetupTarget, buySetup)
sellSetup := processC3(c3SellTrigger, c3SellAllow, false, prevH1[1], state.prevHighBar, currentH[1], prevH2[1], state.prevPrevPrevHighBar, bearSetupCisdLevel, bearSetupCisdIndex, bearStrictCisd, bearSetupCisdBar, bearC3ProtectedLevel, c3SellIdeal, bearC3SetupTarget, sellSetup)

markTrigger(c2BuyTrigger, c2BuyAllow, 2, true)
markTrigger(c2SellTrigger, c2SellAllow, 2, false)
markTrigger(c3BuyTrigger, c3BuyAllow, 3, true)
markTrigger(c3SellTrigger, c3SellAllow, 3, false)

buySetup  := buySetup.extendAndCheck()
sellSetup := sellSetup.extendAndCheck()

buySetup  := buySetup.checkC4Invalid()
sellSetup := sellSetup.checkC4Invalid()

// CISD is final at the qualifying HTF close. No later C3/C4 bar can confirm
// an unconfirmed C2/C3 setup on this strict-timing branch.
if showAlerts
    if c2BuyTrigger and c2BuyAllow
        alert('Bullish C2 formed on ' + syminfo.ticker, alert.freq_once_per_bar)
    if c2SellTrigger and c2SellAllow
        alert('Bearish C2 formed on ' + syminfo.ticker, alert.freq_once_per_bar)
    if c3BuyTrigger and c3BuyAllow
        alert('Bullish C3 closure formed on ' + syminfo.ticker, alert.freq_once_per_bar)
    if c3SellTrigger and c3SellAllow
        alert('Bearish C3 closure formed on ' + syminfo.ticker, alert.freq_once_per_bar)

if showVlines and periodChanged
    vLines.unshift(line.new(bar_index, low - ta.tr, bar_index, high + ta.tr, xloc.bar_index, extend.both, lineColor, lineStyleFromStr(lineStyle), lineWidth))
    while vLines.size() > htfCandleCount
        line.delete(vLines.pop())

//#endregion

//#region [PLOT]

if (barstate.islast or barstate.isrealtime) and validTf and htfCandles.size() > 0 and not hideHtf
    n = htfCandles.size()
    for i = n - 1 to 0
        htfCandles.get(i).draw(bar_index + candleOffset + candleSpacing * (n - 1 - i))
    if showHtfOpen and not na(htfOpenBar)
        curOpenX2 = box.get_right(htfCandles.first().body)
        if na(htfOpenLn)
            htfOpenLn := line.new(htfOpenBar, currentO, curOpenX2, currentO, xloc.bar_index, extend.none, htfOpenColor, lineStyleFromStr(htfOpenStyle), htfOpenWidth)
        else
            line.set_xy1(htfOpenLn, htfOpenBar, currentO)
            line.set_xy2(htfOpenLn, curOpenX2, currentO)
            line.set_color(htfOpenLn, htfOpenColor)
            line.set_style(htfOpenLn, lineStyleFromStr(htfOpenStyle))
            line.set_width(htfOpenLn, htfOpenWidth)
    for i = n - 1 to 0
        c = htfCandles.get(i)
        if i > 0
            nextC = htfCandles.get(i - 1)
            line.set_x2(c.eqLine, nextC.midX)
        if showSweep and (c.triggerBuy or c.triggerSell) and i > 0
            nextC = htfCandles.get(i - 1)
            price = c.triggerBuy ? c.l : c.h
            if na(c.sweepLine)
                c.sweepLine := line.new(c.midX, price, nextC.midX, price, color = sweepColor, style = lineStyleFromStr(sweepStyle), width = sweepWidth)
            else
                line.set_xy1(c.sweepLine, c.midX, price)
                line.set_xy2(c.sweepLine, nextC.midX, price)
                line.set_color(c.sweepLine, sweepColor)
                line.set_style(c.sweepLine, lineStyleFromStr(sweepStyle))
                line.set_width(c.sweepLine, sweepWidth)

if barstate.islast and boolTable
    var table wm = table.new(tablePosition(tableVert, tableHorz), 1, 4,
         bgcolor      = color.new(#000000, 100),
         border_color = dashTextColor,
         border_width = 1,
         frame_color  = dashTextColor,
         frame_width  = 1)

    ltfDisp = tfLabel(ltfCode())
    htfDisp = tfLabel(autoTf)

    table.cell(wm, 0, 0, 'Open Source Fractal', text_color = dashBgColor, bgcolor = dashTextColor, text_size = size.normal, text_halign = text.align_center, text_font_family = font.family_default)

    autoBiasDirStr = selectedAutoBiasDir == 1 ? 'Bullish' : selectedAutoBiasDir == -1 ? 'Bearish' : 'Neutral'
    autoBias1DirStr = autoBias1Dir == 1 ? 'Bullish' : autoBias1Dir == -1 ? 'Bearish' : 'Neutral'
    autoBias2DirStr = autoBias2Dir == 1 ? 'Bullish' : autoBias2Dir == -1 ? 'Bearish' : 'Neutral'
    autoBiasRefStr = selectedBiasLtf != '' and selectedBiasHtf != '' ? tfLabel(selectedBiasLtf) + '-' + tfLabel(selectedBiasHtf) : 'Unavailable'
    confluenceRef1 = biasLtf1 != '' and biasHtf1 != '' ? tfLabel(biasLtf1) + '-' + tfLabel(biasHtf1) : 'Unavailable'
    confluenceRef2 = biasLtf2 != '' and biasHtf2 != '' ? tfLabel(biasLtf2) + '-' + tfLabel(biasHtf2) : 'Unavailable'
    biasDisp = isAutoConfluence ? biasFilter + ' → ' + autoBiasDirStr + '\nAB1 ' + confluenceRef1 + ': ' + autoBias1DirStr + '\nAB2 ' + confluenceRef2 + ': ' + autoBias2DirStr : (isAutoBias1 or isAutoBias2) ? biasFilter + ' → ' + autoBiasDirStr + '\nRef : ' + autoBiasRefStr : biasFilter
    sessionDisp = sessionFilter == 'Off' ? 'Off' : sessionFilter + (sessionAllowsSetup ? ' • OPEN' : ' • CLOSED')
    alignBiasStr = 'Alignment : ' + ltfDisp + '-' + htfDisp + '\n\nBias : ' + biasDisp + '\n\nPOI : ' + poiFilter + '\nTarget : ' + targetMode + '\nSession : ' + sessionDisp
    table.cell(wm, 0, 1, alignBiasStr, text_color = dashTextColor, bgcolor = dashBgColor, text_size = size.small, text_halign = text.align_center, text_font_family = font.family_default)

    dateStr     = str.format_time(time_close, 'dd MMM yyyy', syminfo.timezone)
    clockStr    = str.format_time(timenow, 'HH:mm:ss', syminfo.timezone)
    pairDateStr = syminfo.ticker + '  |  ' + dateStr + '  |  ' + clockStr
    table.cell(wm, 0, 2, pairDateStr, text_color = dashTextColor, bgcolor = dashBgColor, text_size = size.small, text_halign = text.align_center, text_font_family = font.family_default)

    if not validTf
        curTfStr = tfLabel(curTfCode())
        warnMsg  = '⚠ Switch to ' + ltfDisp + ' or lower (now: ' + curTfStr + ')'
        table.cell(wm, 0, 3, warnMsg, text_color = dashBgColor, bgcolor = color.new(#cc0000, 0), text_size = size.small, text_halign = text.align_center, text_font_family = font.family_default)

//#endregion
